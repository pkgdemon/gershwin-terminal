GNUSTEP_INSTALLATION_DOMAIN = SYSTEM

ADDITIONAL_INCLUDE_DIRS += -I../..

ADDITIONAL_OBJCFLAGS += -Wno-deprecated

# TerminalView.m is #include'd directly into t_Selection.m so the test can
# reach its private selection/scroll methods and ivars; these are its real
# collaborators, linked as separate objects (see gnustep-red-green-tdd skill).
t_Selection_OBJC_FILES += ../../Defaults.m \
                          ../../TerminalParser_Linux.m \
                          ../../CharacterWidth.m \
                          ../../BoxDrawing.m

t_Selection_TOOL_LIBS += -lgnustep-gui -lutil -lX11

# -liconv only when a separate libiconv exists to link (NextBSD has none and
# keeps iconv in libc); see ../../GNUmakefile.preamble.
ICONV_LINKS := $(shell printf 'int main(void){return 0;}\n' | \
	$(or $(CC),cc) -x c - -o /dev/null -L/usr/local/lib -liconv >/dev/null 2>&1 && echo yes)
ifeq ($(findstring freebsd,$(GNUSTEP_TARGET_OS)),freebsd)
ifeq ($(ICONV_LINKS),yes)
t_Selection_TOOL_LIBS += -liconv
endif
endif
ifeq ($(findstring openbsd,$(GNUSTEP_TARGET_OS)),openbsd)
t_Selection_TOOL_LIBS += -liconv
endif

# Same in-process inclusion of TerminalView.m as t_Selection.
t_WindowScale_OBJC_FILES += ../../Defaults.m \
                            ../../TerminalParser_Linux.m \
                            ../../CharacterWidth.m \
                            ../../BoxDrawing.m

t_WindowScale_TOOL_LIBS += -lgnustep-gui -lutil -lX11

ifeq ($(findstring freebsd,$(GNUSTEP_TARGET_OS)),freebsd)
ifeq ($(ICONV_LINKS),yes)
t_WindowScale_TOOL_LIBS += -liconv
endif
endif
ifeq ($(findstring openbsd,$(GNUSTEP_TARGET_OS)),openbsd)
t_WindowScale_TOOL_LIBS += -liconv
endif
